<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProspectStudio.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ProspectStudio.Core\ProspectStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CbpFixtures.cs" Link="Market\CbpFixtures.cs" />
    <Compile Include="..\Shared\RepoFixtures.cs" Link="Candidates\RepoFixtures.cs" />
    <Compile Include="..\Shared\SamplePlaces.cs" Link="Candidates\SamplePlaces.cs" />
    <Compile Include="..\Shared\SampleDealers.cs" Link="Dealers\SampleDealers.cs" />
    <Compile Include="..\Shared\FixtureExpectation.cs" Link="Candidates\FixtureExpectation.cs" />
    <Compile Include="..\Shared\PlacesDataFixture.cs" Link="Candidates\PlacesDataFixture.cs" />
    <Compile Include="..\Shared\FileFingerprint.cs" Link="Candidates\FileFingerprint.cs" />
    <Compile Include="..\Shared\FixedTimeProvider.cs" Link="Leads\FixedTimeProvider.cs" />
    <Compile Include="..\Shared\SampleResearch.cs" Link="Leads\SampleResearch.cs" />
    <Compile Include="..\Shared\WorkedExamples.cs" Link="Leads\WorkedExamples.cs" />
  </ItemGroup>

  <!-- The recorded Census CBP response bodies from src/tests/Fixtures/cbp (see its README), the
       Overture places fixtures from src/tests/Fixtures/places and the worked-example research
       documents from src/tests/Fixtures/research. Only those three subfolders: the Core tests are
       pure logic and need no county geometry. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\Fixtures\research\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\Fixtures\research\**\*.cs;$(MSBuildThisFileDirectory)..\Fixtures\research\**\*.md"
             LinkBase="Fixtures\research"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\Fixtures\cbp\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\Fixtures\cbp\**\*.cs;$(MSBuildThisFileDirectory)..\Fixtures\cbp\**\*.md"
             LinkBase="Fixtures\cbp"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)..\Fixtures\places\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\Fixtures\places\**\*.cs;$(MSBuildThisFileDirectory)..\Fixtures\places\**\*.md"
             LinkBase="Fixtures\places"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The spec pack's fixtures travel with the test assembly (technical-design §3): the candidate
       tests read poc/fixtures/sample-places.csv and sample-search-profile.json. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\poc\fixtures\**\*"
             LinkBase="poc\fixtures"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\poc\schemas\**\*"
             LinkBase="poc\schemas"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
