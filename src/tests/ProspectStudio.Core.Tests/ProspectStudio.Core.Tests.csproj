<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProspectStudio.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ProspectStudio.Core\ProspectStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CbpFixtures.cs" Link="Market\CbpFixtures.cs" />
  </ItemGroup>

  <!-- The recorded Census CBP response bodies from src/tests/Fixtures/cbp (see its README). Only that
       subfolder: the C3 market tests are pure logic over those bodies and need no geography data. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\Fixtures\cbp\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\Fixtures\cbp\**\*.cs;$(MSBuildThisFileDirectory)..\Fixtures\cbp\**\*.md"
             LinkBase="Fixtures\cbp"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
