<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProspectStudio.Infrastructure.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The reference-data tests read the Parquet the pipeline writes, and need ST_Within to prove the
         geometry survived. Harmless duplication once Infrastructure references DuckDB itself. -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ProspectStudio.Core\ProspectStudio.Core.csproj" />
    <ProjectReference Include="..\..\ProspectStudio.Infrastructure\ProspectStudio.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\NetworkFactAttribute.cs" Link="Infrastructure\NetworkFactAttribute.cs" />
    <Compile Include="..\Shared\RepoFixtures.cs" Link="Infrastructure\RepoFixtures.cs" />
    <Compile Include="..\Shared\Eventually.cs" Link="Infrastructure\Eventually.cs" />
    <Compile Include="..\Shared\ReferenceDataFixture.cs" Link="Infrastructure\ReferenceDataFixture.cs" />
    <Compile Include="..\Shared\CbpFixtures.cs" Link="Infrastructure\CbpFixtures.cs" />
  </ItemGroup>

  <!-- The geography fixtures generated by src/tests/Fixtures/geo/build-geo-fixtures.cs. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\Fixtures\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\Fixtures\**\*.cs;$(MSBuildThisFileDirectory)..\Fixtures\**\*.md"
             LinkBase="Fixtures"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The spec pack's fixtures and schemas travel with the test assembly (technical-design §3). -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\poc\fixtures\**\*"
             LinkBase="poc\fixtures"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\poc\schemas\**\*"
             LinkBase="poc\schemas"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The migration-drift guard is cross-checked from ProspectStudio.Mcp.Tests, which needs to find
       this project's source; keep the same metadata key the C0 source-rule tests use. -->
  <ItemGroup>
    <AssemblyMetadata Include="ProspectStudioSourceRoot"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))" />
  </ItemGroup>

</Project>
