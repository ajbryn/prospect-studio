<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProspectStudio.Mcp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ProspectStudio.Core\ProspectStudio.Core.csproj" />
    <!-- Explicit, although it also arrives through ProspectStudio.Mcp: the job tests seed the
         server's own SQLite file through AddProspectStudioStorage. -->
    <ProjectReference Include="..\..\ProspectStudio.Infrastructure\ProspectStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\..\ProspectStudio.Mcp\ProspectStudio.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RepoFixtures.cs" Link="Infrastructure\RepoFixtures.cs" />
    <Compile Include="..\Shared\Eventually.cs" Link="Infrastructure\Eventually.cs" />
    <Compile Include="..\Shared\ReferenceDataFixture.cs" Link="Infrastructure\ReferenceDataFixture.cs" />
    <Compile Include="..\Shared\PlacesDataFixture.cs" Link="Infrastructure\PlacesDataFixture.cs" />
    <Compile Include="..\Shared\FileFingerprint.cs" Link="Infrastructure\FileFingerprint.cs" />
    <Compile Include="..\Shared\SamplePlaces.cs" Link="Infrastructure\SamplePlaces.cs" />
  </ItemGroup>

  <!-- The geography fixtures generated by src/tests/Fixtures/geo/build-geo-fixtures.cs. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\Fixtures\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\Fixtures\**\*.cs;$(MSBuildThisFileDirectory)..\Fixtures\**\*.md"
             LinkBase="Fixtures"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The spec pack's fixtures and schemas travel with the test assembly (technical-design §3). -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\poc\fixtures\**\*"
             LinkBase="poc\fixtures"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\poc\schemas\**\*"
             LinkBase="poc\schemas"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The contract tests launch the server as a child process, so they need the path of the
       ProspectStudio.Mcp build output (with its runtimeconfig.json), not the copy in this project's bin. -->
  <ItemGroup>
    <AssemblyMetadata Include="ProspectStudioServerDll"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\ProspectStudio.Mcp\bin\$(Configuration)\$(TargetFramework)\ProspectStudio.Mcp.dll'))" />
    <AssemblyMetadata Include="ProspectStudioSourceRoot"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))" />
  </ItemGroup>

</Project>
