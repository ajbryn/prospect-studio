{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prospect-studio.local/schemas/brand-kit.schema.json",
  "title": "BrandKit",
  "description": "Contents of 'Brand Kit/brand.json'. Paths are relative to the Brand Kit folder.",
  "type": "object",
  "required": ["version", "name", "colors", "logo", "products"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 2 },
    "shortName": { "type": "string" },
    "website": { "type": "string", "pattern": "^https?://" },
    "colors": {
      "type": "object",
      "required": ["primary", "accent", "ink", "paper"],
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "accentInk": { "$ref": "#/$defs/hex" },
        "ink": { "$ref": "#/$defs/hex" },
        "paper": { "$ref": "#/$defs/hex" },
        "dusk": { "$ref": "#/$defs/hex" }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": { "$ref": "#/$defs/font" },
        "body": { "$ref": "#/$defs/font" },
        "mono": { "$ref": "#/$defs/font" }
      }
    },
    "logo": { "type": "string", "description": "SVG or PNG path; needs an .asset.json sidecar." },
    "offerPrefix": { "type": "string", "pattern": "^[A-Z0-9]{2,8}$", "default": "LIFT" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tagline": { "type": "string", "maxLength": 120 },
        "benefits": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 4 },
        "incentive": { "type": "string", "maxLength": 120 },
        "cta": { "type": "string", "maxLength": 40 },
        "legalFooter": { "type": "string", "maxLength": 300 },
        "returnAddress": { "type": "string", "maxLength": 200 }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "image"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "image": { "type": "string", "description": "Transparent PNG or SVG cutout; needs an .asset.json sidecar." },
          "specs": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 4 },
          "anchor": {
            "type": "object",
            "description": "Where the machine touches the ground within the image, as fractions of width/height (for placement and shadow).",
            "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "font": {
      "type": "object",
      "required": ["family"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "fallback": { "type": "string" }
      }
    }
  }
}
