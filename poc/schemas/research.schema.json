{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prospect-studio.local/schemas/research.schema.json",
  "title": "LeadResearch",
  "description": "Claude's deep research for one lead. Every factual signal must cite a URL and a date.",
  "type": "object",
  "required": ["status", "summary", "rationale"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["researched", "no_signal"] },
    "summary": { "type": "string", "minLength": 10, "maxLength": 600, "description": "What the company does, in 1-3 sentences." },
    "segment": { "type": "string", "maxLength": 80 },
    "facilityFit": {
      "type": "object",
      "required": ["level"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["high", "medium", "low", "unknown"] },
        "evidence": { "type": "string", "maxLength": 300 },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "employeeEstimate": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/url" },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "signals": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["type", "text", "url", "date"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["permit", "hiring", "expansion", "news", "funding", "contract", "registry", "other"] },
          "text": { "type": "string", "minLength": 5, "maxLength": 240 },
          "url": { "$ref": "#/$defs/url" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$", "description": "YYYY-MM or YYYY-MM-DD of the underlying event or publication." }
        }
      }
    },
    "suggestedAngle": { "type": "string", "maxLength": 240, "description": "Talking point for the dealer and basis for postcard copy." },
    "personalLine": { "type": "string", "maxLength": 180, "description": "One sentence for the postcard back; public, business-level facts only." },
    "contactRoles": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 5 },
    "llmAdjustment": { "type": "integer", "minimum": -15, "maximum": 15, "default": 0 },
    "rationale": { "type": "string", "minLength": 10, "maxLength": 600, "description": "Why this lead is (or isn't) a good fit, referencing the signals." },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/url" }, "maxItems": 10 },
    "cautions": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 5, "description": "E.g. 'Cold-storage: needs cold-rated equipment'." }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "no_signal" } } },
      "then": { "properties": { "signals": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 2000 }
  }
}
